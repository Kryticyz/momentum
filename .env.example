# Required: PostgreSQL password for the momentum database user.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Optional: API key for Bearer token authentication (empty disables auth).
API_KEY=

# Optional: IANA timezone for date defaults (default: Australia/Sydney).
TIMEZONE=Australia/Sydney

# Optional: Comma-separated CORS allowed origins (default: * in Docker).
CORS_ALLOWED_ORIGINS=*

# Optional: Host ports for Caddy (default: 80 and 443).
HTTP_PORT=80
HTTPS_PORT=443

# Optional: Domain name for production HTTPS (update Caddyfile to use it).
# DOMAIN=your-domain.com
